lninl.com {
    import site_access_log
    encode zstd gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:8787
    }

    handle {
        root * /srv/personal-agent/current/web
        file_server
    }
}

www.lninl.com {
    import site_access_log
    encode zstd gzip
    @html path / /index.html
    header @html Cache-Control "no-cache"

    handle {
        root * /opt/lninl.com
        try_files {path} /index.html
        file_server
    }
}
